ARG BASE_IMAGE=ros:foxy-ros-base-focal
FROM ${BASE_IMAGE}

ARG ROS_APT_MIRROR=http://packages.ros.org/ros2/ubuntu
ARG SOPHUS_VERSION=1.22.10
ARG LIVOX_SDK_VERSION=v1.3.1
ARG LIVOX_DRIVER_VERSION=1.2.6
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN mkdir -p /tmp && chmod 1777 /tmp \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && rm -f /etc/apt/sources.list.d/ros2*.list /etc/apt/sources.list.d/ros2*.sources \
    && printf 'deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] %s focal main\n' "${ROS_APT_MIRROR}" > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake curl ca-certificates git python3-colcon-common-extensions python3-rosdep python3-yaml \
        ros-foxy-ros-base ros-foxy-rviz2 ros-foxy-cv-bridge \
        ros-foxy-image-transport ros-foxy-image-transport-plugins \
        ros-foxy-pcl-ros ros-foxy-pcl-conversions ros-foxy-tf2-geometry-msgs ros-foxy-rclcpp-action \
        libceres-dev libgoogle-glog-dev libeigen3-dev libopencv-contrib-dev libpcl-dev \
        libcgal-dev libboost-all-dev libfmt-dev libyaml-cpp-dev libtbb-dev qtbase5-dev nlohmann-json3-dev libapr1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/deps \
    && curl -fsSL "https://codeload.github.com/strasdat/Sophus/tar.gz/refs/tags/${SOPHUS_VERSION}" | tar xz -C /tmp/deps \
    && cmake -S "/tmp/deps/Sophus-${SOPHUS_VERSION}" -B /tmp/sophus-build -DBUILD_SOPHUS_TESTS=OFF -DBUILD_SOPHUS_EXAMPLES=OFF \
    && cmake --build /tmp/sophus-build --target install -j2 \
    && curl -fsSL "https://codeload.github.com/Livox-SDK/Livox-SDK2/tar.gz/refs/tags/${LIVOX_SDK_VERSION}" | tar xz -C /tmp/deps \
    && cmake -S "/tmp/deps/Livox-SDK2-${LIVOX_SDK_VERSION#v}" -B /tmp/sdk-build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/sdk-build -j2 \
    && cmake --install /tmp/sdk-build \
    && ldconfig \
    && curl -fsSL "https://codeload.github.com/Livox-SDK/livox_ros_driver2/tar.gz/refs/tags/${LIVOX_DRIVER_VERSION}" | tar xz -C /tmp/deps \
    && cp "/tmp/deps/livox_ros_driver2-${LIVOX_DRIVER_VERSION}/package_ROS2.xml" "/tmp/deps/livox_ros_driver2-${LIVOX_DRIVER_VERSION}/package.xml" \
    && source /opt/ros/foxy/setup.bash \
    && colcon --log-base /tmp/driver-log build --base-paths "/tmp/deps/livox_ros_driver2-${LIVOX_DRIVER_VERSION}" \
        --build-base /tmp/driver-build --install-base /opt/livox --executor sequential \
        --cmake-args -DROS_EDITION=ROS2 -DDISTRO_ROS=foxy -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /tmp/deps /tmp/sophus-build /tmp/sdk-build /tmp/driver-build /tmp/driver-log

WORKDIR /ws
CMD ["bash", "-c", "source /opt/ros/foxy/setup.bash && source /opt/livox/setup.bash && exec bash"]
