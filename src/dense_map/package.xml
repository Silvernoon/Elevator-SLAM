<?xml version="1.0"?>
<package format="3">
  <name>dense_map</name>
  <version>0.1.0</version>
  <description>RGB-D mapping and BRIEF pose graph loop closure with timestamp-aligned fusion IMU poses.</description>
  <maintainer email="qintonguav@gmail.com">Elevator-SLAM maintainers</maintainer>
  <license>GPL-3.0</license>
  <license>LGPL-3.0-or-later</license>
  <license>CC-BY-NC-SA-3.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>camera_models</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <depend>libopencv-dev</depend>
  <depend>libceres-dev</depend>
  <depend>eigen</depend>
  <depend>boost</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
