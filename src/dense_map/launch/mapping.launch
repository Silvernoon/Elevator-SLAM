<launch>
  <!-- config_file supplies original VIO camera calibration; shared extrinsics
       distinguish the physical LIO IMU from the original VIO IMU. -->
  <arg name="config_file"/>
  <arg name="extrinsics_file" default=""/>
  <arg name="pose_topic" default="/fusion/odometry"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="keyframe_pose_topic" default="/vins_estimator/keyframe_pose"/>
  <arg name="keyframe_point_topic" default="/vins_estimator/keyframe_point"/>
  <arg name="extrinsic_topic" default="/vins_estimator/extrinsic"/>
  <!-- Optional row-major physical LIO_IMU_T_camera, not VIO body_T_cam0. -->
  <arg name="imu_t_camera" default="[]"/>
  <arg name="output_path" default="$(env HOME)/.ros/dense_map"/>
  <arg name="pose_graph_save_path" default="$(arg output_path)/pose_graph"/>
  <arg name="load_previous_pose_graph" default="false"/>
  <arg name="save_on_shutdown" default="true"/>
  <arg name="frame_id" default="fusion_world"/>
  <arg name="fusion_child_frame" default="fusion_imu"/>
  <arg name="sync_tolerance" default="0.01"/>
  <arg name="max_pose_gap" default="0.10"/>
  <arg name="buffer_duration" default="5.0"/>
  <arg name="buffer_size" default="300"/>
  <arg name="depth_enabled" default="true"/>
  <arg name="depth_scale" default="0.001"/>
  <arg name="depth_stride" default="10"/>
  <arg name="use_imu" default="true"/>
  <node pkg="dense_map" type="dense_map_node" name="dense_map" output="screen">
    <rosparam if="$(eval arg('extrinsics_file') != '')" command="load" file="$(arg extrinsics_file)"/>
    <param name="config_file" value="$(arg config_file)"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="keyframe_pose_topic" value="$(arg keyframe_pose_topic)"/>
    <param name="keyframe_point_topic" value="$(arg keyframe_point_topic)"/>
    <param name="extrinsic_topic" value="$(arg extrinsic_topic)"/>
    <rosparam if="$(eval arg('imu_t_camera') != '[]')" param="imu_t_camera" subst_value="true">$(arg imu_t_camera)</rosparam>
    <param name="output_path" value="$(arg output_path)"/>
    <param name="pose_graph_save_path" value="$(arg pose_graph_save_path)"/>
    <param name="load_previous_pose_graph" value="$(arg load_previous_pose_graph)"/>
    <param name="save_on_shutdown" value="$(arg save_on_shutdown)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="fusion_child_frame" value="$(arg fusion_child_frame)"/>
    <param name="sync_tolerance" value="$(arg sync_tolerance)"/>
    <param name="max_pose_gap" value="$(arg max_pose_gap)"/>
    <param name="buffer_duration" value="$(arg buffer_duration)"/>
    <param name="buffer_size" value="$(arg buffer_size)"/>
    <param name="depth_enabled" value="$(arg depth_enabled)"/>
    <param name="depth_scale" value="$(arg depth_scale)"/>
    <param name="depth_stride" value="$(arg depth_stride)"/>
    <param name="use_imu" value="$(arg use_imu)"/>
  </node>
</launch>
