Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: fusion_world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Ground grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: Fused scan
      Enabled: true
      Topic: /fusion/cloud_world
      Queue Size: 4
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Position Transformer: XYZ
      Decay Time: 20
    - Class: rviz/Odometry
      Name: Fused odometry
      Enabled: true
      Topic: /fusion/odometry
      Keep: 200
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Pitch: 0.65
      Yaw: 0.8
