<launch>
  <arg name="lio_config" default="root_config.yaml" />
  <arg name="vio_config" default="$(find vins)/config/realsense/m3dgr.yaml" />
  <arg name="fusion_config" default="$(find elevator_fusion)/config/fusion.yaml" />
  <arg name="mesh_config" default="$(find im_mesh)/config/mapping.yaml" />
  <arg name="extrinsics_file" default="" />
  <arg name="enable_vio" default="true" />
  <arg name="enable_mesh" default="true" />
  <arg name="enable_mesh_color" default="true" />
  <arg name="enable_dense_map" default="false" />
  <arg name="enable_global_fusion" default="false" />
  <arg name="decompress_images" default="true" />
  <arg name="rviz" default="false" />
  <arg name="show_mesh_gui" default="false" />
  <arg name="use_sim_time" default="true" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <node pkg="lio" type="lio" name="lio" output="screen" required="true">
    <param name="config_path" value="$(arg lio_config)" />
  </node>
  <group if="$(arg decompress_images)">
    <node pkg="image_transport" type="republish" name="color_decompress"
          args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw" />
    <node pkg="image_transport" type="republish" name="depth_decompress"
          args="compressedDepth in:=/camera/aligned_depth_to_color/image_raw raw out:=/camera/aligned_depth_to_color/image_raw" />
  </group>
  <include if="$(arg enable_vio)" file="$(find vins)/launch/vio.launch">
    <arg name="config_file" value="$(arg vio_config)" />
  </include>
  <include file="$(find elevator_fusion)/launch/fusion.launch">
    <arg name="config" value="$(arg fusion_config)" />
    <arg name="extrinsics_file" value="$(arg extrinsics_file)" />
    <arg name="enable_vio" value="$(arg enable_vio)" />
  </include>
  <include if="$(arg enable_mesh)" file="$(find im_mesh)/launch/mapping.launch">
    <arg name="show_gui" value="$(arg show_mesh_gui)" />
    <arg name="extrinsics_file" value="$(arg extrinsics_file)" />
    <arg name="config_file" value="$(arg mesh_config)" />
    <arg name="color_enabled" value="$(arg enable_mesh_color)" />
  </include>
  <include if="$(arg enable_dense_map)" file="$(find dense_map)/launch/mapping.launch">
    <arg name="config_file" value="$(arg vio_config)" />
    <arg name="extrinsics_file" value="$(arg extrinsics_file)" />
  </include>
  <include if="$(arg enable_global_fusion)" file="$(find global_fusion)/launch/global.launch" />
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find elevator_slam)/config/fusion.rviz" />
</launch>
