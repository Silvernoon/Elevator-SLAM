<launch>
  <arg name="config_file" default="$(find im_mesh)/config/mapping.yaml" />
  <arg name="extrinsics_file" default="" />
  <arg name="show_gui" default="false" />
  <arg name="color_enabled" default="true" />
  <arg name="cloud_topic" default="/fusion/cloud_world" />
  <arg name="odom_topic" default="/fusion/odometry" />
  <arg name="image_topic" default="/camera/color/image_raw" />
  <arg name="imu_t_camera" default="[]" />
  <arg name="output_mesh" default="$(env HOME)/.ros/fusion_mesh.ply" />
  <node pkg="im_mesh" type="external_mapping" name="meshing" output="screen" required="true">
    <rosparam command="load" file="$(arg config_file)" />
    <rosparam if="$(eval arg('extrinsics_file') != '')" command="load" file="$(arg extrinsics_file)" />
    <rosparam if="$(eval arg('imu_t_camera') != '[]')" param="imu_t_camera" subst_value="true">$(arg imu_t_camera)</rosparam>
    <param name="show_gui" value="$(arg show_gui)" />
    <param name="color_enabled" value="$(arg color_enabled)" />
    <param name="cloud_topic" value="$(arg cloud_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="output_mesh" value="$(arg output_mesh)" />
  </node>
</launch>
