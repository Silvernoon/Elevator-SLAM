<launch>
  <!-- Weights are intentionally neither bundled nor downloaded by CMake. -->
  <arg name="weights_path" doc="Directory containing the trained YOLO weights (required)"/>
  <arg name="weights_file" default="yolov3.weights"/>
  <arg name="config_file" default="yolov3.cfg"/>
  <arg name="config_path" default="$(find vins)/yolo_network_config/cfg"/>
  <arg name="network_param_file" default="$(find vins)/config/yolov3.yaml"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="view_image" default="false"/>
  <node pkg="vins" type="darknet_ros" name="darknet_ros" output="screen" required="true">
    <rosparam command="load" file="$(arg network_param_file)"/>
    <param name="weights_path" value="$(arg weights_path)"/>
    <param name="config_path" value="$(arg config_path)"/>
    <param name="yolo_model/weight_file/name" value="$(arg weights_file)"/>
    <param name="yolo_model/config_file/name" value="$(arg config_file)"/>
    <param name="subscribers/camera_reading/topic" value="$(arg image_topic)"/>
    <param name="image_view/enable_opencv" value="$(arg view_image)"/>
  </node>
</launch>
