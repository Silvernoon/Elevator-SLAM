<?xml version="1.0"?>
<package format="2">
  <name>vins</name>
  <version>1.0.0</version>
  <description>Visual inertial wheel depth line and GNSS estimator with standalone YOLO transport</description>
  <maintainer email="qintonguav@gmail.com">qintong</maintainer>
  <license>GPL-3.0</license>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>camera_models</depend>
  <depend>image_transport</depend>
  <depend>actionlib</depend>
  <depend>darknet_ros_msgs</depend>
  <depend>rosbag</depend>
  <depend>gnss_comm</depend>
  <depend>eigen</depend>
  <depend>ceres-solver</depend>
  <depend>libopencv-dev</depend>
  <depend>boost</depend>
